# L’URL publique de Neon Auth ne contient aucun mot de passe PostgreSQL.
EXPO_PUBLIC_NEON_AUTH_URL=https://your-dev-endpoint.neonauth.region.aws.neon.tech/neondb/auth
# Origine autorisée dans Neon Auth. localhost:3000 est fonctionnelle sur la branche dev actuelle.
EXPO_PUBLIC_AUTH_ORIGIN=http://localhost:3000
# Sur un téléphone physique, renseigner l’IP locale du PC, jamais localhost.
# Sans cette variable, Expo Go déduit l’IP du serveur Metro en développement.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
